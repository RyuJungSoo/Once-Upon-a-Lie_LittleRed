  stageClearMessage: "\uB05D\uB09C \uAC74 \uC544\uB2C8\uC9C0\uB9CC, \uC801\uC5B4\uB3C4
    \uC9C0\uAE08\uC740 \uAD1C\uCC2E\uC544.\n\uC228\uC744 \uACE0\uB974\uACE0 \uAE38\uC744
